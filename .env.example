# ============================================================================
# VARIÁVEIS DE AMBIENTE - SELLCONTROL
# ============================================================================
# Copie este arquivo para .env e preencha com seus valores reais

# SUPABASE
# Obter em: Project Settings > API no painel do Supabase
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# UUID do seu tenant — gerado ao rodar o INSERT do schema.sql
VITE_TENANT_ID=uuid-do-seu-tenant-aqui

# ============================================================================
# INTEGRAÇÕES DE ENVIO (Sistema de Automação de Envios)
# ============================================================================

# MELHOR ENVIO - Cotação de Frete e Etiquetas
# Tutorial: https://docs.melhorenvio.com.br/
# 1. Criar conta em: https://melhorenvio.com.br/
# 2. Acessar sandbox: https://sandbox.melhorenvio.com.br/
# 3. Menu → Gerenciar → Aplicações → Criar aplicação
# 4. Copiar o token gerado
VITE_MELHOR_ENVIO_API_URL=https://sandbox.melhorenvio.com.br
VITE_MELHOR_ENVIO_TOKEN=seu_token_melhor_envio_aqui

# MERCADO PAGO - Pagamento PIX
# Tutorial: https://www.mercadopago.com.br/developers/pt/docs
# 1. Criar conta em: https://www.mercadopago.com.br/
# 2. Acessar: https://www.mercadopago.com.br/developers/panel
# 3. Criar aplicação → Suas integrações
# 4. Copiar Access Token de TESTE (começa com TEST-)
VITE_MERCADO_PAGO_ACCESS_TOKEN=seu_access_token_mercado_pago_aqui

# ============================================================================
# IMPORTANTE:
# - Use credenciais de TESTE primeiro (Sandbox/TEST)
# - Depois que tudo funcionar, troque pelas de PRODUÇÃO
# - Nunca commite o arquivo .env (já está no .gitignore)
# ============================================================================
