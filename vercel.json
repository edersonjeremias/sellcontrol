{
  "rewrites": [
    {
      "source": "/api/mercadopago/:path*",
      "destination": "https://api.mercadopago.com/:path*"
    },
    {
      "source": "/loja/:slug/p/:codigo",
      "destination": "/api/loja-peca?slug=:slug&codigo=:codigo"
    },
    {
      "source": "/bio/:slug",
      "destination": "/api/bio?slug=:slug"
    },
    {
      "source": "/b/:slug",
      "destination": "/api/bio?slug=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
